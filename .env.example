# Required on the OVH VPS (copy to .env.local or .env)
ADMIN_PASSWORD=change-this-before-going-live
ADMIN_SESSION_TOKEN=change-this-long-random-string

# Public contact shown on the event sheet
NEXT_PUBLIC_CONTACT_EMAIL=hello@for-everevents.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_SITE_URL=https://for-everevents.com

